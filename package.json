    "legra-glycan.js": "github:hirenj/legra-glycan.js",
    "phoria-glycan.js": "github:CopenhagenCenterForGlycomics/phoria-glycan.js",
    "rough-glycan.js": "github:CopenhagenCenterForGlycomics/rough-glycan.js",
    "zdog-glycan.js": "github:CopenhagenCenterForGlycomics/zdog-glycan.js"
  },
  "peerDependencies": {
    "glycan.js": ">= 0.0.1"
  },
  "overrides": {
    "glycan.js": "github:CopenhagenCenterForGlycomics/glycan.js"
  },
  "exports": {
    ".": "./js/main.js",
