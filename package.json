    "./lite": "./js/sviewer/lite.js",
    "./cache-sviewer": "./js/sviewer/cache-sviewer.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/preset-env": "^7.29.7",
    "babel-loader": "^8.0.5",
